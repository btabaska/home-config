8880    # kokoro — CPU TTS for OWUI voice (lai-10)
8931    # playwright-mcp — headless browser MCP (lai-11)
9000    # comfyui-mcp — image gen/edit MCP (lai-11)
9292    # llama-swap
11434   # ollama (host)
22000   # syncthing — sync protocol
