# Shelfmark env — copy to shelfmark.env, fill secrets from the vault, chmod 600.
PUID=1026
PGID=100
TZ=America/New_York
SEARCH_MODE=universal
# Metadata: Hardcover primary (again, 2026-09-07). 2026-09-06 the deployed JWT's
# account was INACTIVE upstream (401 "User account is not active") so we ran
# OpenLibrary (keyless) as a stopgap. A fresh `hc_pat_` personal-access-token
# (vault books.hardcover_api_token, account RobitFarmer) is now active → back to
# Hardcover for richer edition metadata. Free plan: 60 req/min, burst 10, 5,000/day.
METADATA_PROVIDER=hardcover
HARDCOVER_ENABLED=true
OPENLIBRARY_ENABLED=true
# 2026-09-06: disable the metadata cache. Shelfmark's @cacheable stores any
# non-None result, and a transient egress timeout / 429 (more likely now that we're
# on a rate-limited free-plan token) returns [] — so the empty result was cached
# for 300s, turning a rare failure into a 5-minute "No results found" for that query.
# With caching off, every search hits the provider live and a bad result self-clears
# on the next request. (ENV wins over /config/settings.json.)
METADATA_CACHE_ENABLED=false
HARDCOVER_API_KEY=          # vault: books.hardcover_api_token
INGEST_DIR=/books
# Direct Download (Anna's Archive) fallback source
DIRECT_DOWNLOAD_ENABLED=true
# Prowlarr (MAM etc.) — primary source
PROWLARR_ENABLED=true
PROWLARR_URL=http://192.168.10.4:9696
PROWLARR_API_KEY=           # vault: arr_api_keys.prowlarr
PROWLARR_USE_SEED_PREFERENCES=true
PROWLARR_TORRENT_CLIENT=deluge
PROWLARR_TORRENT_ACTION=keep
# Seedbox Deluge (same endpoint Bookshelf uses)
DELUGE_HOST=100.119.134.94
DELUGE_PORT=5945
DELUGE_PASSWORD=            # vault: deluge.password
DELUGE_CATEGORY=shelfmark
DELUGE_DOWNLOAD_DIR=/home/hd34/btabaska/files
# Non-env (persisted in /config via settings API): USE_DOH=false, AA_MIRROR_URLS,
# USING_EXTERNAL_BYPASSER=true + EXT_BYPASSER_URL=http://192.168.10.4:8191 (flaresolverr)
