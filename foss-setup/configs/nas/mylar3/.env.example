# Mylar3 — read-21. No secrets are injected via compose; this file documents the ONE external
# credential Mylar3 needs so an operator can restore it out-of-band.
#
# The ComicVine API key (metadata authority) is applied to /config/mylar/config.ini
# ([General] comicvine_api) during first-run, NOT as a container env var — the LSIO
# mylar3 image has no ComicVine env var. Real value lives ONLY in the vault:
#     foss-setup/.handoff-secrets.yaml  ->  comicvine.api_key
# Never commit the value; reference it by vault key path only.
MYLAR3_COMICVINE_API_KEY=
