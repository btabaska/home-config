# /etc/mini-deadman.env — config for the off-mini dead-man (fix-63/SH19).
# Deploy to the rig at /etc/mini-deadman.env, chmod 600 root:root. The topic is a
# secret (anyone who knows it can read the mini-down pages on the public relay).
#
#   MINI_DEADMAN_NTFY_TOPIC  vault: alerting.mini_deadman_ntfy_topic
#   MINI_DEADMAN_NTFY_URL    vault: alerting.mini_deadman_ntfy_url  (https://ntfy.sh)
MINI_DEADMAN_NTFY_URL=https://ntfy.sh
MINI_DEADMAN_NTFY_TOPIC=REPLACE_WITH_VAULT_alerting.mini_deadman_ntfy_topic

# Optional overrides (defaults shown):
# MINI_HOST=192.168.10.2
# MINI_PORT=443
# FAIL_THRESHOLD=3
# REPAGE_SECS=3600
