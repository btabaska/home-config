# /etc/default/sonarr-backlog-season-search  (root:root 600)
# Sonarr API key — vault arr_api_keys.sonarr
SONARR_API_KEY=<SONARR_API_KEY>
# Optional overrides (defaults shown):
#SONARR_URL=http://192.168.10.4:8989
#COOLDOWN_DAYS=14
#MIN_AGE_DAYS=7
# 2026-08-12: counts distinct problem DOWNLOADS (warnings grouped by
# downloadId, drained partial packs ignored) — NOT warning records. A series
# with a problem download just sits out; the global skip means systemic
# breakage (mount dead / disk full).
#MAX_QUEUE_WARNINGS=15
#HEALTHCHECKS_PING_URL=
