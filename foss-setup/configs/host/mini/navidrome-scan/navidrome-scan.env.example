# /etc/navidrome-scan.env  (root:root 0600 on mini) — fill from the vault.
# Subsonic/OpenSubsonic admin auth for the mount-gated scan trigger. Reuse the
# same admin token pair the Homepage widget uses:
#   NAVIDROME_USER  <- vault navidrome.username
#   NAVIDROME_TOKEN <- vault homepage_widgets.navidrome_token   (md5(password+salt))
#   NAVIDROME_SALT  <- vault homepage_widgets.navidrome_salt
# (Or compute a fresh salt+token from vault navidrome.password.)
NAVIDROME_USER=
NAVIDROME_TOKEN=
NAVIDROME_SALT=
