# /etc/default/arr-queue-reconcile — env for the fix-54 queue reconciler.
# Install: root:btabaska 0640 (the service runs as btabaska; keys must not be
# world-readable). Real keys live in the vault at arr_api_keys.{sonarr,radarr}.
SONARR_URL=http://192.168.10.4:8989
SONARR_API_KEY=<vault arr_api_keys.sonarr>
RADARR_URL=http://192.168.10.4:7878
RADARR_API_KEY=<vault arr_api_keys.radarr>
# Only records older than this (hours) in a 'warning' state are eligible.
MAX_AGE_HOURS=72
# Safety cap on removals per run.
MAX_REMOVALS=25
# Set to 1 to log candidates without deleting (dry-run).
#DRY_RUN=1
# Optional dead-man ping (vault healthchecks.*). Leave unset to skip.
#HEALTHCHECKS_PING_URL=https://health.tabaska.us/ping/<uuid>
