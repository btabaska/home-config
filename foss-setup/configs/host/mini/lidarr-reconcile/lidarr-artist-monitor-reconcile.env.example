# /etc/default/lidarr-artist-monitor-reconcile — env for the media-07 reconciler.
# Install: root:btabaska 0640 (the service runs as btabaska; the key must not be
# world-readable). Real LIDARR_API_KEY lives in the vault at arr_api_keys.lidarr.
LIDARR_URL=http://192.168.10.4:8686
LIDARR_API_KEY=<vault arr_api_keys.lidarr>
# Optional dead-man ping (vault healthchecks.*). Leave unset to skip.
#HEALTHCHECKS_PING_URL=https://health.tabaska.us/ping/<uuid>
