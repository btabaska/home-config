# /etc/default/soularr-denylist-reconcile — env for the fix-56 soularr denylist
# reconciler. Install: root:btabaska 0640 (the service runs as btabaska; the key
# must not be world-readable). Real LIDARR_API_KEY lives in the vault at
# arr_api_keys.lidarr (== lidarr.api_key).
LIDARR_URL=http://192.168.10.4:8686
LIDARR_API_KEY=<vault arr_api_keys.lidarr>
# ssh alias for the NAS that owns soularr's data dir (btabaska has key-based ssh
# nas from the mini). The denylist path inside that dir.
NAS_SSH=nas
DENYLIST_PATH=/volume1/docker/soularr/failed_imports.json
# Optional dead-man ping (vault healthchecks.*). Leave unset to skip.
#HEALTHCHECKS_PING_URL=https://health.tabaska.us/ping/<uuid>
