# BookLogr API env — copy to .env and fill AUTH_SECRET_KEY (gitignored on the mini).
# The real AUTH_SECRET_KEY lives in the vault: booklogr.auth_secret_key.
DATABASE_URL=sqlite:///books.db
AUTH_SECRET_KEY=CHANGEME
# Set True ONLY for the one-time initial account signup, then flip to
# False and recreate (fix-85: was left open — booklogr-registration-closed guards it).
AUTH_ALLOW_REGISTRATION=False
AUTH_REQUIRE_VERIFICATION=False
SINGLE_USER_MODE=False
EXPORT_FOLDER="export_data"
