# Meme Review — server configuration. Copy to .env and edit.

# Port the Hono API + static server listens on (Caddy reverse-proxies /api to it).
PORT=8787

# Where the SQLite DB, uploads and derived-image cache live.
DATA_DIR=./data

# Session cookie secret — any long random string. Sessions are signed with it.
SESSION_SECRET=change-me-to-a-long-random-string

# Set true behind HTTPS (Caddy) so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# --- Immich (optional) ---
# Leave blank to run in upload-only mode. Can also be set at runtime in Settings.
IMMICH_BASE_URL=
IMMICH_API_KEY=
IMMICH_DEFAULT_ALBUM_ID=

# Can anyone with a drop link add reactions, or only signed-in members?
# 'members' (default) or 'guests'.
GUEST_REACTIONS=members
