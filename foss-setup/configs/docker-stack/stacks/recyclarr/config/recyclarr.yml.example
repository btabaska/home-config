# Recyclarr — TRaSH templates → NAS Sonarr/Radarr
# Copy to config/recyclarr.yml and fill API keys from each *arr UI (Settings → General).
# Docs:    https://recyclarr.dev/guide/getting-started/
# Schema:  https://recyclarr.dev/reference/config-examples/  (guide-backed quality_profiles)
# Naming:  https://recyclarr.dev/reference/configuration/media-naming/
#
# trash_id values are guide-backed profiles. Verify/find ids with:
#   recyclarr list quality-profiles sonarr   (or radarr)
# media_naming values are KEYS from `recyclarr list naming <service>` — `default`
# is the TRaSH-recommended scheme. (The earlier `plex-tmdb` value was NOT a valid
# key and would be skipped/error.)

sonarr:
  sonarr_main:
    base_url: http://192.168.10.4:8989
    api_key: <SONARR_API_KEY>
    # 2026-08-11: quality_definition + quality_profiles sync DISABLED (commented out).
    # The WEB-1080p profile (id 7) now carries deliberate manual deviations that make
    # old-show backlog clearing work (2026-08-11 Prowlarr/backlog fix):
    #   - 2160p tiers enabled BELOW the WEB-1080p cutoff as last-resort fallback
    #     (old shows often only have 2160p season packs; cutoff/upgrades unchanged)
    #   - WEBDL/WEBRip-1080p min size 15 -> 5 MB/min (90s cartoons run ~9 MB/min;
    #     guide minimum rejected legit episodes)
    # x265 (HD) score manually restored to guide value -10000 on the same date.
    # Re-enabling this sync would silently revert the fallback and re-break the
    # backlog. Proper fix later: encode the custom profile explicitly in recyclarr.
    # quality_definition:
    #   type: series
    # quality_profiles:
    #   - trash_id: 72dae194fc92bf828f32cde7744e51a1   # WEB-1080p (verified TRaSH id)
    #     reset_unmatched_scores:
    #       enabled: true
    media_naming:
      series: default
      season: default
      episodes:
        rename: true
        standard: default

radarr:
  radarr_main:
    base_url: http://192.168.10.4:7878
    api_key: <RADARR_API_KEY>
    quality_definition:
      type: movie
    quality_profiles:
      - trash_id: d1d67249d3890e49bc12e275d989a7e9   # HD Bluray + WEB (verified TRaSH id)
        reset_unmatched_scores:
          enabled: true
    media_naming:
      folder: default
      movie:
        rename: true
        standard: plex-tmdb
